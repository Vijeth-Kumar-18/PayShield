# ==========================================
# PAYSHIELD .gitignore
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output & Cache
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
/coverage

# Environment & Secrets (NEVER COMMIT)
.env*
.env
.env*.local
.env.example

# Sensitive files & Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel & Deployment
.vercel

# Generated Prisma Client
/src/generated/prisma

# Operating System & IDE Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-workspace
*.sublime-project
